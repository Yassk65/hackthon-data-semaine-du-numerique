# Copiez ce fichier en `.env` pour les essais locaux (`netlify dev`). Le fichier `.env` est ignoré par git.
# En production, créez ces variables dans Netlify : Site configuration > Environment variables.
# Ne mettez JAMAIS une vraie clé dans ce fichier d'exemple.

# Clé OpenRouter (https://openrouter.ai/keys). Créez-en une dédiée, avec une limite de crédit.
OPENROUTER_API_KEY=

# Modèles (facultatif). Voir https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash

# Plafonds journaliers (facultatif)
LIMIT_JOBS_PER_IP_DAY=40
LIMIT_REPORTS_PER_IP_DAY=8
LIMIT_REPORTS_GLOBAL_DAY=150
